<%= image_tag @flat.picture_url, class: "card-img-top", style: "height: 400px; object-fit: cover;" %>
<div class="container mt-4">
  <div class="row">
    <div class="col-lg-8 mx-auto">
      <div class="bg-light p-3 rounded mb-3">
        <h1><%= @flat.name %></h1>
        <p><%= @flat.address %></p>
      </div>
      <div class="bg-light p-3 rounded mb-3">
        <h2>A bit more about this flat...</h2>
        <p><%= @flat.description %></p>
      </div>
      <div class="bg-light p-3 rounded mb-3">
        <h2>Details</h2>
          <div class="d-flex">
            <p class="me-3"><i class="fa-solid fa-users me-2"></i><%= @flat.number_of_guests %> guests</p>
            <p><i class="fa-solid fa-sterling-sign me-2"></i><%= @flat.price_per_night %> /night</p>
          </div>
      </div>

      <%= link_to "Delete Flat",
        flat_path(@flat), class:"btn btn-danger",
        data: {turbo_method: :delete, turbo_confirm: "Are you sure?"}
      %>

      <%= link_to "Edit Flat", edit_flat_path(@flat), class: "btn btn-warning" %>
    </div>
  </div>
</div>
